{
	"name": "obzorarr",
	"private": true,
	"version": "0.1.11",
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"dev:env": "bun --bun --env-file=.env vite dev",
		"build": "bun --bun vite build",
		"smoke:production": "bun run scripts/smoke-production.ts",
		"qa:wrapped-lookup": "bun run scripts/verify-wrapped-lookup.ts",
		"preview": "bun --bun vite preview",
		"start": "NODE_ENV=production bun ./build/index.js",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test --env-file=.env.test",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"check:biome": "biome check .",
		"dogfood:scrub": "bun run scripts/scrub-dogfood-output.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run scripts/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"postinstall": "prek install || true"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@internationalized/date": "^3.12.0",
		"@j178/prek": "^0.5.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/kit": "^2.57.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/bun": "^1.3.12",
		"@types/sanitize-html": "^2.16.1",
		"@unocss/reset": "^66.6.8",
		"drizzle-kit": "^0.31.10",
		"fast-check": "^4.6.0",
		"formsnap": "^2.0.1",
		"rollup-plugin-visualizer": "^7.0.1",
		"svelte": "^5.55.4",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.4.6",
		"sveltekit-superforms": "^2.30.1",
		"typescript": "^6.0.2",
		"unocss": "^66.6.8",
		"unocss-preset-animations": "^1.3.0",
		"unocss-preset-shadcn": "^1.0.1",
		"vite": "^8.0.8",
		"@typescript/native": "npm:typescript@7.0.2"
	},
	"dependencies": {
		"@lucide/svelte": "^1.16.0",
		"bits-ui": "^2.17.3",
		"clsx": "^2.1.1",
		"croner": "^10.0.1",
		"drizzle-orm": "^0.45.2",
		"gsap": "^3.15.0",
		"marked": "^18.0.0",
		"motion": "^13.0.0",
		"sanitize-html": "^2.17.2",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"zod": "^4.3.6"
	},
	"packageManager": "bun@1.4.2"
}
