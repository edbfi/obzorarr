{
	"name": "obzorarr",
	"private": true,
	"license": "AGPL-3.0-only",
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"scripts": {
		"prepare": "bun --bun svelte-kit sync && bun --bun paraglide-js compile && bun --bun panda codegen",
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun ./build",
		"check": "bun --bun svelte-kit sync && bun --bun paraglide-js compile && bun --bun panda codegen && bun --bun svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "bun --bun vitest run",
		"smoke": "bun --bun playwright test",
		"lint": "bun --bun biome ci"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#styled-system/*": "./styled-system/*/index.js"
	},
	"devDependencies": {
		"@ark-ui/svelte": "5.25.0",
		"@biomejs/biome": "2.6.4",
		"@inlang/paraglide-js": "3.2.1",
		"@inlang/plugin-i18next": "6.5.3",
		"@pandacss/dev": "2.4.0",
		"@pandacss/preset-base": "2.4.0",
		"@pandacss/vite": "2.4.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-bun": "1.0.0",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	}
}
