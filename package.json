{
	"name": "obzorarr",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.5",
	"scripts": {
		"prepare": "bun --bun svelte-kit sync && bun --bun paraglide-js compile && bun --bun panda codegen && bun --bun panda cssgen --splitting",
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun ./build",
		"check": "bun --bun svelte-kit sync && bun --bun paraglide-js compile && bun --bun panda codegen && bun --bun panda cssgen --splitting && bun --bun svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "bun --bun vitest run",
		"smoke": "bun --bun playwright test",
		"lint": "bun --bun biome ci",
		"db:generate": "bun --bun drizzle-kit generate && bun --bun biome format --write drizzle"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#styled-system/styles/*": "./styled-system/styles/*",
		"#styled-system/*": "./styled-system/*/index.js"
	},
	"devDependencies": {
		"@ark-ui/svelte": "5.25.1",
		"@biomejs/biome": "2.6.8",
		"@fontsource-variable/instrument-sans": "5.3.0",
		"@fontsource-variable/space-grotesk": "5.3.0",
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@inlang/paraglide-js": "3.2.2",
		"@inlang/plugin-i18next": "6.5.3",
		"@lucide/svelte": "1.77.0",
		"@pandacss/dev": "2.6.0",
		"@pandacss/preset-base": "2.6.0",
		"@pandacss/vite": "2.6.0",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-bun": "1.0.2",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tursodatabase/database": "0.8.4",
		"drizzle-kit": "1.0.0-rc.6",
		"drizzle-orm": "1.0.0-rc.6",
		"svelte": "5.59.1",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	}
}
