# Obzorarr Environment Configuration
#
# Values containing & * # $ ! or other shell-special characters
# MUST be wrapped in single quotes or escaped, e.g.:
#   PLEX_TOKEN='abc&def$ghi'
# Do NOT use double quotes (they preserve $ expansion).
# `source .env` works only with quoted values; `dotenv-cli` is more robust.

# =============================================================================
# OPTIONAL: Plex Media Server (can also be configured from the admin UI after onboarding)
# =============================================================================
# Find your token: https://support.plex.tv/articles/204059436
# Leave these commented out unless you want to lock the values at the env layer.
# Setting `PLEX_TOKEN=your-plex-token-here` (the literal placeholder string)
# is treated as unset by the runtime so an unedited copy of this file doesn't
# trip the onboarding flow.
# PLEX_SERVER_URL=http://localhost:32400
# PLEX_TOKEN=your-plex-token-here

# =============================================================================
# OPTIONAL (defaults shown)
# =============================================================================

# Server
# PORT=3000
# HOST=0.0.0.0
# ORIGIN=https://your-domain.com    # Public origin (links, sign-in redirects, cookies) and CSRF origin; include any
#                                   # non-default port. REQUIRED for plain HTTP (e.g. http://192.168.1.10:3000);
#                                   # leave unset only behind an HTTPS proxy that preserves Host. Always wins over
#                                   # forwarded headers.
# TRUST_PROXY=false                 # Only without ORIGIN: enable only behind an isolated proxy that overwrites both
#                                   # X-Forwarded-Proto and X-Forwarded-Host
# IDLE_TIMEOUT=10                   # Client idle timeout in seconds (maps to CONNECTION_IDLE_TIMEOUT); event streams are exempt

# Database
# DATABASE_PATH=data/obzorarr.db

# Scheduling
# TZ=Etc/UTC                        # IANA zone the sync schedule and log retention cleanup run in;
#                                   # overrides Admin -> Settings -> System. An unknown zone is ignored.
# METADATA_CONCURRENCY=8
# ENABLE_LIVE_SYNC=true

# AI Fun Facts (leave empty to use templates instead)
# OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# DEVELOPMENT ONLY (ignored in production)
# =============================================================================

# Bypass Plex OAuth in dev mode
# DEV_BYPASS_AUTH=true
# DEV_BYPASS_USER=              # empty=owner, "random", <plexId>, or <username>
# DEV_PLEX_TOKEN=               # Valid Plex.tv token for onboarding testing (use when PLEX_TOKEN is empty)
